# Dashboard credentials
ADMIN_USERNAME=erenmoris
ADMIN_PASSWORD=1234

# Secret used to sign the dashboard session cookie — change this in production
SESSION_SECRET=change-me-to-a-long-random-string

# Postgres connection string (Vercel Postgres / Neon / Supabase).
# When set, reservations + CMS content are stored in Postgres; otherwise local JSON files are used.
# DATABASE_URL=

# Optional: where the local JSON fallback is stored (defaults to ./data)
# SAHRA_DATA_DIR=

# Vercel Blob — required for production media uploads (gallery images + promo video).
# 1) Vercel Dashboard → Storage → Create Blob Store → connect to this project
# 2) Redeploy so BLOB_READ_WRITE_TOKEN is injected (or paste it here for local testing)
# Without this token, local uploads still work under public/uploads/
# BLOB_READ_WRITE_TOKEN=

# Public site URL — used for canonical links, sitemap and OpenGraph
# NEXT_PUBLIC_SITE_URL=https://sahra-website.vercel.app

# Business WhatsApp shown to visitors (no + prefix)
# NEXT_PUBLIC_WHATSAPP_NUMBER=201027059930

# Email alert when a new reservation arrives (Resend — free tier: resend.com)
# 1) Create account at https://resend.com and copy API key
# 2) Add RESEND_API_KEY below (Vercel → Settings → Environment Variables)
# 3) Redeploy — emails go to erenmoris5@gmail.com by default
# OWNER_NOTIFY_EMAIL=erenmoris5@gmail.com
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=Sahra Bookings <onboarding@resend.dev>

# Token from Google Search Console (HTML tag method)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
